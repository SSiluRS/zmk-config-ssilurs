#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL | GUI | ALT |  D  |  F  |  G  |   |  H  |  J   |  K  | ALT | GUI |  '    |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |      |
            // hold: 1=fun  2=nav  3=mouse     4=sym 5=num    tap: ESC TAB SPC | ENT BSP DEL

            bindings = <
&kp GRAVE         &kp Q           &kp W           &kp E      &kp R      &kp T          &kp Y        &kp U            &kp I       &kp O            &kp P               &kp LEFT_BRACKET
&kp LEFT_SHIFT    &mt LEFT_GUI A  &mt LEFT_ALT S  &kp D      &kp F      &kp G          &kp H        &kp J            &kp K       &mt RIGHT_ALT L  &mt RIGHT_GUI SEMI  &kp APOSTROPHE
&kp LEFT_CONTROL  &kp Z           &kp X           &kp C      &kp V      &kp B          &kp N        &kp M            &kp COMMA   &kp DOT          &kp FSLH            &none
                                                  &lt 1 ESC  &lt 2 TAB  &lt 3 ENTER    &lt 4 ENTER  &lt 5 BACKSPACE  &kp DELETE
            >;
        };

        fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN    &bt BT_SEL 0    &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK     &trans          &kp RSHFT          &kp RCTRL        &kp LALT      &kp LGUI      &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK    &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT    &bt BT_CLR    &bt BT_CLR_ALL
                         &trans  &trans  &trans             &trans          &kp C_PLAY_PAUSE   &kp C_STOP
            >;
        };

        nav {
            bindings = <
&trans  &kp LC(Z)      &kp LC(X)          &kp LC(C)      &kp LC(V)      &kp LC(Y)        &kp K_UNDO      &kp K_PASTE     &kp K_COPY    &kp K_CUT  &kp KP_NUMLOCK  &trans
&trans  &kp LGUI       &kp LALT           &kp LCTRL      &kp LSHFT      &trans           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp CAPSLOCK    &trans
&trans  &kp LC(MINUS)  &kp LC(LS(MINUS))  &kp LS(LA(F))  &kp LC(LS(F))  &kp LS(LC(H))    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END    &kp INSERT      &trans
                                          &trans         &trans         &trans           &trans          &trans          &trans
            >;
        };

        mouse {
            bindings = <
&trans  &kp K_REDO  &kp K_CUT     &kp K_COPY        &kp K_PASTE     &kp K_UNDO    &mkp MB4        &trans          &trans        &mkp MB5         &trans  &trans
&trans  &kp LGUI    &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans      &trans        &trans            &trans          &trans        &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &trans
                                  &trans            &trans          &trans        &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;
        };

        sym {
            bindings = <
&trans  &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE    &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp COLON       &kp DOLLAR       &kp PERCENT           &kp CARET              &kp PLUS           &trans  &kp RSHFT  &kp RCTRL  &kp LALT  &kp LGUI  &trans
&trans  &kp TILDE       &kp EXCLAMATION  &kp AT                &kp HASH               &kp PIPE           &trans  &trans     &trans     &trans    &trans    &trans
                                         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER          &trans  &trans     &trans
            >;
        };

        num {
            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &trans  &trans     &trans         &trans    &trans    &trans
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &kp RSHFT  &kp RCTRL      &kp LALT  &kp LGUI  &trans
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans     &kp LESS_THAN  &kp GT    &trans    &trans
                           &kp DOT  &kp N0  &kp MINUS    &trans  &trans     &trans
            >;
        };
    };
};
